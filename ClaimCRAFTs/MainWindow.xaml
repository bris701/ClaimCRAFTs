<Window x:Class="ClaimCRAFTs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClaimCRAFTs" Width="435" Height="690" MinWidth="350" MinHeight="365"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="9"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource WindowSurfaceBrush}" BorderBrush="#354152"
          BorderThickness="1" CornerRadius="9" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource TitleSurfaceBrush}"
              BorderBrush="#303B4A" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="9,0,5,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="WindowTitle" Text="ClaimCRAFTs v0.3.1" Foreground="#F2F5F9"
                     FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PinButton" Content="📌" Style="{StaticResource TitleButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Toggle always on top" Click="PinButton_Click" />
            <Button Content="⚙" Style="{StaticResource TitleButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Claim and appearance settings" Click="SettingsButton_Click" />
            <Button Content="—" Style="{StaticResource TitleButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" Click="MinimizeButton_Click" />
            <Button Style="{StaticResource CloseTitleButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Click="CloseButton_Click">
              <!-- A centered vector X avoids font-baseline offsets in the title bar. -->
              <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Width="14" Height="14"
                    Stretch="None" Stroke="#F2A1A1" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="8,7,8,7">
        <Grid x:Name="OverviewView">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- Full-width selector: left-aligned claim name and right-aligned U+2BC6 glyph. -->
          <Button Grid.Row="0" Style="{StaticResource ClaimSelectorButton}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="27"
                  Margin="0,0,0,6" Padding="10,3" Click="SettingsButton_Click"
                  ToolTip="Click to search or change claims">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ClaimNameLabel" Grid.Column="0" Text="Select a claim" FontSize="12.5"
                         FontWeight="SemiBold" Foreground="{DynamicResource DisplayTextBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         HorizontalAlignment="Left"/>
              <TextBlock Grid.Column="1" Text="⯆" FontFamily="Segoe UI Symbol" FontSize="13"
                         Foreground="{DynamicResource DisplayTextBrush}" VerticalAlignment="Center"
                         HorizontalAlignment="Right" Margin="9,0,0,0"/>
            </Grid>
          </Button>
          <Grid Grid.Row="1" Margin="2,0,2,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#F4B75E" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock x:Name="ConnectionLabel" Text="Select claim" FontSize="10.5"
                         Foreground="{DynamicResource DisplayTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,7,0">
              <ToggleButton x:Name="LiveToggle" Style="{StaticResource LivePillToggle}"
                            IsChecked="True" VerticalAlignment="Center" Margin="0,0,5,0"
                            ToolTip="Enable or pause automatic crafting updates"
                            Checked="LiveToggle_Changed" Unchecked="LiveToggle_Changed"/>
              <TextBlock x:Name="LiveLabel" Text="Live: ON" FontSize="10"
                         Foreground="{DynamicResource DisplayTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource CompactRefreshButton}" Margin="0,0,7,0"
                    ToolTip="Request a fresh snapshot (maximum once every 5 seconds)" Click="RefreshButton_Click">
              <!-- Keep the refresh symbol centered geometrically rather than by a font baseline. -->
              <Viewbox Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="M 19,11 A 7.5,7.5 0 1 0 18,16 M 14,11 L 19,11 L 19,6"
                        Stroke="#E4EAF2" StrokeThickness="2" Fill="Transparent"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="UpdatedLabel" Text="Last Update: --:--" FontSize="10"
                         Foreground="{DynamicResource DisplayTextBrush}" VerticalAlignment="Center"/>
              <Grid Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center"
                    ToolTip="Time of last received update">
                <Canvas Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <!-- Optical centering: WPF's text baseline sits below the geometric midpoint. -->
                  <Canvas.RenderTransform><TranslateTransform Y="2"/></Canvas.RenderTransform>
                  <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                           Stroke="{DynamicResource DisplayTextBrush}" StrokeThickness="1.1"/>
                  <Path Data="M 6,3 L 6,6 L 8,7" Stroke="{DynamicResource DisplayTextBrush}"
                        StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
              </Grid>
            </StackPanel>
          </Grid>
          <Border x:Name="ErrorBanner" Grid.Row="2" Background="{DynamicResource ErrorSurfaceBrush}"
                  BorderThickness="0" CornerRadius="6"
                  Padding="7,5" Margin="0,0,0,5" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="#FFC2C7" TextWrapping="Wrap" FontSize="10.5"/>
          </Border>
          <ScrollViewer x:Name="OverviewScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkScrollBar}"/></ScrollViewer.Resources>
            <StackPanel x:Name="OverviewContent"/>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="SettingsView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="3,1,0,8">
            <TextBlock Text="ClaimCRAFTs settings" Foreground="#F2F5F9" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Choose any BitCraft claim, then customize the overlay." Foreground="#9BA8B8" FontSize="10"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkScrollBar}"/></ScrollViewer.Resources>
            <StackPanel Margin="3,0,8,0">
              <TextBlock Text="SELECT A CLAIM" Foreground="#9BA8B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,4" />
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ClaimSearchInput" Style="{StaticResource DarkTextBox}" Height="33" Padding="8,6"
                         ToolTip="Search by claim name" KeyDown="ClaimSearchInput_KeyDown"/>
                <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Margin="5,0,0,0" Padding="10,5"
                        Style="{StaticResource PrimaryButton}" Click="SearchButton_Click"/>
              </Grid>
              <TextBlock x:Name="SearchStatus" Text="Type a claim name and select Search."
                         Foreground="#9BA8B8" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <StackPanel x:Name="SearchResults" Margin="0,0,0,12" />

              <TextBlock Text="BACKGROUND OPACITY" Foreground="#9BA8B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,2"/>
              <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="BackgroundOpacityValue" DockPanel.Dock="Right" Foreground="#DCE4EF" FontSize="10" Width="40" TextAlignment="Right"/>
                <Slider x:Name="BackgroundOpacitySlider" Minimum="1" Maximum="100" Value="100" TickFrequency="5"
                        ValueChanged="AppearanceSlider_ValueChanged"/>
              </DockPanel>
              <TextBlock Text="TEXT OPACITY" Foreground="#9BA8B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,2"/>
              <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="TextOpacityValue" DockPanel.Dock="Right" Foreground="#DCE4EF" FontSize="10" Width="40" TextAlignment="Right"/>
                <Slider x:Name="TextOpacitySlider" Minimum="1" Maximum="100" Value="100" TickFrequency="5"
                        ValueChanged="AppearanceSlider_ValueChanged"/>
              </DockPanel>
              <TextBlock Text="TEXT COLOUR · WHITE → BLACK" Foreground="#9BA8B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,2"/>
              <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="TextShadeValue" DockPanel.Dock="Right" Foreground="#DCE4EF" FontSize="10" Width="68" TextAlignment="Right"/>
                <Slider x:Name="TextShadeSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                        ValueChanged="AppearanceSlider_ValueChanged"/>
              </DockPanel>
              <Border Background="{DynamicResource SummarySurfaceBrush}" CornerRadius="6" Padding="7,5" Margin="0,0,0,12">
                <TextBlock x:Name="AppearancePreview" Text="Preview: live crafting projects" FontSize="11"
                           Foreground="{DynamicResource DisplayTextBrush}" />
              </Border>
              <TextBlock Text="DATA SOURCE" Foreground="#9BA8B8" FontWeight="Bold" FontSize="10" Margin="0,0,0,3"/>
              <TextBlock Text="ResuBaka public API + MessagePack WebSocket. Requires an internet connection."
                         Foreground="#9BA8B8" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <TextBlock Foreground="#B8C6D5" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8">
                <Run Text="A BIG THANK YOU! " FontWeight="Bold" Foreground="#F2F5F9"/>
                <Run Text="to ResuBaka for providing the API support and valuable feedback during the development of this Tool! Click on the Links below to visit his Bitcraft Hub website as well as the github repo that the tool was based on."/>
              </TextBlock>
              <TextBlock FontSize="10.5" Margin="0,0,0,5">
                <Run Text="Bitcraft Hub: " Foreground="#B8C6D5"/>
                <Hyperlink NavigateUri="https://craft.resubaka.dev"
                           RequestNavigate="ExternalLink_RequestNavigate"
                           Foreground="#9CD5D0" TextDecorations="Underline">https://craft.resubaka.dev</Hyperlink>
              </TextBlock>
              <TextBlock FontSize="10.5" Margin="0,0,0,12" TextWrapping="Wrap">
                <Run Text="Github Repo: " Foreground="#B8C6D5"/>
                <Hyperlink NavigateUri="https://github.com/ResuBaka/bitcraft-hub"
                           RequestNavigate="ExternalLink_RequestNavigate"
                           Foreground="#9CD5D0" TextDecorations="Underline">https://github.com/ResuBaka/bitcraft-hub</Hyperlink>
              </TextBlock>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
            <Button Content="Done" Style="{StaticResource PrimaryButton}" Padding="13,7" Click="DoneButton_Click"/>
          </StackPanel>
        </Grid>
      </Grid>
      <Grid Grid.RowSpan="2">
        <Thumb Height="5" VerticalAlignment="Top" Cursor="SizeNS" Opacity="0" Tag="Top" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" Tag="Bottom" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" Tag="Left" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" Tag="Right" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0" Tag="TL" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0" Tag="TR" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0" Tag="BL" DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0" Tag="BR" DragDelta="ResizeThumb_DragDelta"/>
      </Grid>
    </Grid>
  </Border>
</Window>
